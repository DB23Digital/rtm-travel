# The gated assets. Reachable only through ../download.php, which reads them off
# disk after a lead is captured, so the old public URL cannot be shared onward.
<IfModule mod_authz_core.c>
  Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
  Order deny,allow
  Deny from all
</IfModule>

# Old bookmarked links land on the gated article instead of a raw Apache error.
# The target sits outside this denied directory, so Apache can serve it.
ErrorDocument 403 /corporate-travel-policy-template
